%YAML 1.2
---
name: NewASM Overlay
file_extensions:
  - newasm
scope: source.cpp.newasm

extends: Packages/C++/C++.sublime-syntax

contexts:
  main:
    - match: \b(async|cast|in|out|default|switch|case|vmov|await|retf|cls|load|stor|sysreq|pop|retn|mov|syscall|proc|call|rem|halt|push|jmp|heap|cmp|je|jne|jl|jg|jle|jge|ret|zero|inc|dec|exit|end|nop|add|sub|div|mul|exp|log|and|or|xor|not|shl|shr|db|malloc|free|stack|wait|sysenter|xchg|int|__say)\b
      scope: keyword.control.newasm

    - match: \b(num|decm|txt|char|ref|obj|thread|tuple|bit_arr|bin_tree)\b
      scope: keyword.control.newasm

    - match: \block\b
      scope: keyword.control.newasm

    - match: \busing\b
      scope: keyword.control.newasm

    - match: \b(bos|tlr|stl|stk|hea|psx|prp|cpt|tr0|tr1|fdx|cpr|br0|br1|cr0|cr1)\b
      scope: register.control.newasm

    - match: ^\s*:[a-zA-Z_][a-zA-Z0-9_]*
      scope: labels.newasm

    - match: \.(text|data|start|hndl)
      scope: keyword.section.newasm

    - match: %\w+
      scope: variable.register.newasm

    - match: 0c\w+
      scope: constant.numeric.newasm

    - match: \b\d+_\b
      scope: constant.numeric.newasm

    - begin: '"'
      end: '"'
      scope: string.quoted.double.newasm

    - begin: "'"
      end: "'"
      scope: string.quoted.single.newasm

    - match: ";.*$"
      scope: comment.line.semicolon.newasm

    - match: "#.*$"
      scope: comment.line.semicolon.newasm

    - match: \b\d+(\.\d+)?\b
      scope: constant.numeric.newasm

    - match: \b0x[0-9a-fA-F]+\b
      scope: constant.hex.newasm
