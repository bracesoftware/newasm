{
  "$schema": "vscode://schemas/color-theme",
  "name": "NewASM Dark",
  "type": "dark",
  "colors": {
    "editor.foreground": "#D4D4D4",
    "editor.background": "#1E1E1E"
  },
  "tokenColors": [
    {
      "name": "Brackets",
      "scope": [
        "punctuation.bracket",
        "punctuation.parenthesis",
        "punctuation.brace"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "name": "Types declaration and references",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.other.attribute",
        "entity.name.scope-resolution",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Control flow / Special keywords",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator",
        "entity.name.operator",
        "namespace"
      ],
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "String literals",
      "scope": ["string"],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "number"
      ],
      "settings": {
        "foreground": "#b5cea8"
      }
    },
    {
      "scope": "keyword.control.newasm",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "keyword.section.newasm",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "register.control.newasm",
      "settings": {
        "foreground": "#A1C4E8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "labels.newasm",
      "settings": {
        "foreground": "#C792EA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable.register.newasm",
      "settings": {
        "foreground": "#7FDBCA"
      }
    },
    {
      "scope": "string.quoted.double.newasm",
      "settings": {
        "foreground": "#ECC48D"
      }
    },
    {
      "scope": "comment.line.semicolon.newasm",
      "settings": {
        "foreground": "#7c817a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "constant.numeric.newasm",
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": "constant.hex.newasm",
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": "namespace.newasm",
      "settings": {
        "foreground": "#7FDBCA"
      }
    },
    {
      "scope": "declaration.newasm",
      "settings": {
        "foreground": "#e5e0e9"
      }
    }
  ]
}
