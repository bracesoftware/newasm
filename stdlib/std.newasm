.data
./std
intg version: 31

./math
float pi: 3.141
./!math
./!std
.start
.$__newasm_sys_interrupt __std_now__
;
; Start of the STD
;
;============================================================================================
.start
; using "ios" ; using iostream for printing
./std
./ios
proc write
.$__newasm_cfg_manip __autobos=__TRUE
.$__newasm_krnl_config IOS/YES__
; DEPRECATED->mov stl, 0c0 ; null terminator

mov fdx, 0

switch *tlr
case intg -> mov fdx, 2
case float -> mov fdx, 2
case string -> mov fdx, 1
case char -> mov fdx, 7
case ref -> mov fdx, 6
default -> nop ;mov fdx, 1

sysenter "ios"
syscall
.$__newasm_krnl_config IOS/NO__
.$__newasm_cfg_manip __autobos=__FALSE
halt 0
end

proc writeln
.$__newasm_cfg_manip __autobos=__TRUE
.$__newasm_krnl_config IOS/YES__
; mov stl, 0c1 ; newline character

mov fdx, 0

switch *tlr
case 1 -> mov fdx, 2
case intg -> mov fdx, 2
case float -> mov fdx, 2
case string -> mov fdx, 1
case char -> mov fdx, 7
case ref -> mov fdx, 6
default -> nop ;mov fdx, 1

sysenter "ios"
syscall

mov tlr, "\n" ; we just print newline char
mov fdx, 1
syscall

.$__newasm_cfg_manip __autobos=__FALSE
.$__newasm_krnl_config IOS/NO__
halt 0
end
./!ios
./math
proc fadd
zero imm
mov cr0, *tlr
mov cr1, *stl

add

mov tlr, *cr0
halt 0
end

proc fsub
zero imm
mov cr0, *tlr
mov cr1, *stl

sub

mov tlr, *cr0
halt 0
end

proc fmul
zero imm
mov cr0, *tlr
mov cr1, *stl

mul

mov tlr, *cr0
halt 0
end

proc fdiv
zero imm
mov cr0, *tlr
mov cr1, *stl

div

mov tlr, *cr0
halt 0
end

proc fexp
zero imm
mov cr0, *tlr
mov cr1, *stl

exp

mov tlr, *cr0
halt 0
end

proc flog
zero imm
mov cr0, *tlr
mov cr1, *stl

log

mov tlr, *cr0
halt 0
end

proc imod
mov imm, 1
mov cr2, *tlr
mov cr3, *stl

log

mov tlr, *cr2
halt 0
end

proc iadd
mov imm, 1
mov cr2, *tlr
mov cr3, *stl

add

zero imm
mov tlr, *cr2
halt 0
end

proc isub
mov imm, 1
mov cr2, *tlr
mov cr3, *stl

sub

zero imm
mov tlr, *cr2
halt 0
end

proc imul
mov imm, 1
mov cr2, *tlr
mov cr3, *stl

mul

zero imm
mov tlr, *cr2
halt 0
end

proc idiv
mov imm, 1
mov cr2, *tlr
mov cr3, *stl

div

zero imm
mov tlr, *cr2
halt 0
end

proc iexp
mov imm, 1
mov cr2, *tlr
mov cr3, *stl

exp

zero imm
mov tlr, *cr2
halt 0
end

proc ilog
mov imm, 1
mov cr2, *tlr
mov cr3, *stl

log

zero imm
mov tlr, *cr2
halt 0
end

./!math
./!std
.data
./std
./__P
intg input: 0 ; argument
intg temp: 0
intg result: 0
./!__P
.start
./math
proc ifac
mov imm, 1
mov &std::__P::input, *tlr ; we take tlr as input lel
mov &std::__P::result, std::__P::input ; result = 5
mov &std::__P::temp, std::__P::input ; temp = 5
cmp tlr, 0
jz finished
{:funcBody}
mov cr2, std::__P::temp
mov cr3, 1
sub ; temp = temp - 1
mov &std::__P::temp, *cr2 ; temp

cmp cr2, 0 ; if(temp == 0)
jz finished ; finished

mov cr3, std::__P::temp
mov cr2, std::__P::result ; cr2 = result
mul ; result = result * temp
mov &std::__P::result, *cr2 ; save

jmp funcBody

{:finished}
mov tlr, std::__P::result
zero imm
halt 0
end
./!math
./!std

;============================================================================================
;
; EOF
;
.$__newasm_sys_interrupt __std_now__
